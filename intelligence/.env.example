# ─── MarketCheck (PRIMARY — self-serve, instant signup) ───────────────────────
# Covers: listing history, odometer readings, auction appearances, price history
# Signup: https://www.marketcheck.com/thank-you-api/
# Free tier: 500 calls/month (no credit card required)
# With this key: confidence score 45 → 70/100
MARKETCHECK_API_KEY=
MARKETCHECK_API_SECRET=

# ─── CARFAX (enterprise only — requires signed dealer agreement) ───────────────
# Covers: accident reports, dealer-reported service records
# Only viable with an existing CARFAX Service Data Transfer Facilitation Agreement
CARFAX_API_KEY=
CARFAX_API_BASE=https://api.carfax.com/v1

# ─── Experian AutoCheck (requires Experian data partnership) ──────────────────
# Covers: wholesale/auction history, title transitions
AUTOCHECK_API_KEY=
AUTOCHECK_API_BASE=https://api.autocheck.com/v1

# ─── NMVTIS (requires approved provider contract) ─────────────────────────────
# Covers: title brand, salvage, junk, insurance total loss
# Approved providers: ClearVin (clearvin.com), AutoDataDirect (add123.com)
NMVTIS_API_KEY=
NMVTIS_API_BASE=
